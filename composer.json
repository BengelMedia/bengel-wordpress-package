{
    "name": "bengel/wordpress-common",
    "type": "library",
    "description": "Common utilities for wordpress plugins and themes.",
    "autoload": {
        "psr-4": {
            "Bengel\\Wordpress\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Freek Attema",
            "email": "freek@bengelmedia.nl"
        }
    ],
    "require-dev": {
        "php-stubs/wordpress-stubs": "*",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
